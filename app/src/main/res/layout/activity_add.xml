<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить аниме"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Название -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название аниме"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9C27B0"
            android:layout_marginBottom="16dp"/>

        <!-- Описание -->
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Описание (до 100 символов)"
            android:maxLength="100"
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9C27B0"
            android:layout_marginBottom="24dp"/>

        <!-- Квадрат для выбора фото -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обложка (аватарка)"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp"/>

        <FrameLayout
            android:id="@+id/frameImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="#333333"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/tvPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="40sp"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"/>
        </FrameLayout>

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрать обложку"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- Кнопка выбора видео -->
        <Button
            android:id="@+id/btnPickVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Загрузить видео"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- Статус загрузки -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Файлы не выбраны"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Кнопка Сохранить -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Опубликовать"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>
